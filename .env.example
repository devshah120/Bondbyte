# Copy to .env.local for development. In production these live in the env
# file pm2 loads (see deploy/ecosystem.config.cjs). Never commit real values.

# ── Admin panel (/admin) ───────────────────────────────────────────────────
# The starting login. Once you set your own under "Login and password" it is
# stored (hashed) in DATA_DIR/auth.json and this one stops working; delete that
# file to use this one again.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Long random string that signs admin sessions. Without it, everyone is signed
# out whenever the server restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# How long an admin stays signed in, in hours.
# TOKEN_TTL_HOURS=12

# Where content, inquiries, uploads, version history and the admin login are
# stored. Defaults to ./data. In production use a folder outside the deployed
# release, e.g. /var/www/bondbyte/data, and include it in backups.
# DATA_DIR=/var/www/bondbyte/data

# Largest image the media library accepts, in MB (nginx needs a
# client_max_body_size a bit above it).
# MAX_UPLOAD_MB=10

# Admin cookies are marked Secure in production. Set to true only while the
# site is served over plain http (before SSL is set up).
# INSECURE_COOKIES=false

# ── Email notifications for new inquiries (optional) ──────────────────────
# Inquiries are always saved and shown in the admin panel. When SMTP_HOST,
# SMTP_USER and SMTP_PASS are all set, each one is also emailed.

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASS=
SMTP_FROM_NAME=Example
SMTP_FROM_EMAIL=support@example.com

# Optional — inbox that receives enquiries. Defaults to the contact email in
# General settings.
# CONTACT_TO_EMAIL=support@example.com

# Optional — set to "true" only if your host requires implicit TLS on a
# non-standard port. Port 465 is detected as implicit TLS automatically.
# SMTP_SECURE=false
