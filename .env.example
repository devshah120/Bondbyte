# Copy to .env.local and fill in real values. Never commit .env.local.
#
# SMTP delivery for the contact form. When SMTP_HOST, SMTP_USER and SMTP_PASS
# are all set, the API route sends mail; otherwise it reports that email is
# not configured instead of silently dropping the submission.

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASS=
SMTP_FROM_NAME=Example
SMTP_FROM_EMAIL=support@example.com

# Optional — inbox that receives enquiries. Defaults to SITE.email.
# CONTACT_TO_EMAIL=support@example.com

# Optional — set to "true" only if your host requires implicit TLS on a
# non-standard port. Port 465 is detected as implicit TLS automatically.
# SMTP_SECURE=false
